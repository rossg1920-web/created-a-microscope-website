# Clover Hosted Checkout credentials
# Get these from: Clover Dashboard → Settings → Ecommerce → Ecommerce API Tokens
# Create a token with Integration Type = "Hosted checkout"

CLOVER_MERCHANT_ID=your_merchant_id_here
CLOVER_PRIVATE_TOKEN=your_private_api_token_here

# sandbox (default) or production
CLOVER_ENV=sandbox

# Public URL of this site (used for success/cancel redirects)
# For local testing:
SITE_BASE_URL=http://localhost:8080

# PORT=8080
